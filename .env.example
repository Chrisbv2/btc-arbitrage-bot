# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Demo mode: lowers the min-profitable-spread threshold from 0.15% → 0.01%
# so opportunities are detected frequently for live demonstrations.
# Set to false (or remove) for realistic paper trading.
DEMO_MODE=true

# Absolute path to SQLite file (created automatically)
DB_PATH=./data/arb.db

# Trade size in BTC used for net-profit calculations (paper trading only)
TRADE_SIZE_BTC=0.01

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Dev origin (always allowed)
FRONTEND_URL=http://localhost:5173
# Production Vercel URL — add after first deploy, e.g. https://arb-bot.vercel.app
VERCEL_URL=

# ── Exchange API Keys (not required for price-feed-only mode) ─────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Leave unset for local dev (the hook defaults to http://localhost:3001 directly,
# bypassing the Vite proxy which buffers SSE frames).
# Set to your Railway/Render backend URL for production Vercel builds.
VITE_API_URL=
