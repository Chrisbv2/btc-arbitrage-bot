# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Absolute path to SQLite file (created automatically)
DB_PATH=./data/arb.db

# Trade size in BTC used for net-profit calculations (paper trading only)
TRADE_SIZE_BTC=0.01

# ── CORS / Frontend ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Exchange API Keys (not required for price-feed-only mode) ─────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Leave empty for Vite proxy (local dev). Set to backend URL for production builds.
VITE_API_URL=
